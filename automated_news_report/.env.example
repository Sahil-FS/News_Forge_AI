# Copy this file to .env and fill in your values
# .env is gitignored — never commit your actual keys

PEXELS_API_KEY=your_pexels_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_key_here
PIPER_EXECUTABLE=piper/piper.exe
PIPER_MODEL=./piper/en_US-lessac-medium.onnx
DEBUG_MODE=true
NEWS_UI_API_KEY=your_ui_api_key_here
NEWS_UI_PORT=8088

# YouTube Upload Scheduling Config (in minutes)
# UPLOAD_SPACING_MINUTES=150
# UPLOAD_JITTER_MIN=15
# UPLOAD_JITTER_MAX=45
