# ==============================================================================
# News Forge AI - Environment Configuration (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in automated_news_report/.env (or project root).
# 2. Fill in the keys/settings appropriate for your environment.
# 3. .env is gitignored and should NEVER be committed to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Media & Stock Footage APIs (Optional but Recommended)
# ------------------------------------------------------------------------------
# Pexels API Key: Used to fetch HD stock footage and contextual editorial photos.
# Free signup: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Unsplash Access Key: Fallback source for high-resolution photography.
# Free signup: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# ------------------------------------------------------------------------------
# 2. Text-to-Speech (TTS) Engines
# ------------------------------------------------------------------------------
# Kokoro TTS (Primary): Automatically downloads hexgrad/Kokoro-82M on first run.
# Piper TTS (Secondary/Fallback): Pre-bundled for Windows in automated_news_report/piper
PIPER_EXECUTABLE=piper/piper.exe
PIPER_MODEL=./piper/en_US-lessac-medium.onnx

# ------------------------------------------------------------------------------
# 3. System & Debug Flags
# ------------------------------------------------------------------------------
# Enables detailed pipeline logging, timing breakdown, and console output.
DEBUG_MODE=true

# ------------------------------------------------------------------------------
# 4. Operator Web UI Server
# ------------------------------------------------------------------------------
# Port for the local Web Dashboard (default: 8088 -> http://localhost:8088)
NEWS_UI_PORT=8088

# Optional UI Security Key (leave empty for open local access, or set a token)
NEWS_UI_API_KEY=

# ------------------------------------------------------------------------------
# 5. YouTube Automation & Upload Policy
# ------------------------------------------------------------------------------
# Set to 'true' to enable automated uploading after video rendering
# Note: Requires OAuth setup (client_secrets_*.json) and one-time browser login.
AUTO_UPLOAD=true

# Video privacy setting on upload: 'private' (recommended for review), 'unlisted', or 'public'
AUTO_UPLOAD_PRIVACY=private

# YouTube category ID ('25' = News & Politics)
# AUTO_UPLOAD_CATEGORY_ID=25

# ------------------------------------------------------------------------------
# 6. YouTube Batch Scheduling & Anti-Spam Spacing
# ------------------------------------------------------------------------------
# Target minutes between successive scheduled uploads
UPLOAD_SPACING_MINUTES=120

# Random jitter in minutes added to spacing to maintain natural publishing cadence
UPLOAD_JITTER_MIN=15
UPLOAD_JITTER_MAX=45

# Default video batch size per run
BATCH_COUNT=6

# Daily boundary cutoff hour (in local time 24h, default 5 = 5:00 AM)
BATCH_BOUNDARY_HOUR=5

# Minimum enforced buffer between any two consecutive scheduled videos
BATCH_MIN_SPACING_MINUTES=30
